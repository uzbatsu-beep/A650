{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a650/profile.schema.json",
  "title": "A650 Configurator Parameter Profile",
  "type": "object",
  "required": ["schema_version", "device", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "tool_version": {"type": "string"},
    "device": {
      "type": "object",
      "required": ["slave_address"],
      "properties": {
        "model": {"type": "string", "default": "ONI A650"},
        "slave_address": {"type": "integer", "minimum": 1, "maximum": 247},
        "baud_rate": {"type": "integer", "enum": [4800, 9600, 19200, 38400, 57600, 115200]},
        "data_format": {"type": "string", "enum": ["1-8-N-2", "1-8-E-1", "1-8-O-1", "1-8-N-1"]},
        "firmware_version": {"type": ["string", "null"]}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["param_id", "raw_value"],
        "properties": {
          "param_id": {"type": "string", "pattern": "^[FHU][0-9]{2}\\.[0-9]{2}$"},
          "address": {"type": "integer", "minimum": 0, "maximum": 65535},
          "raw_value": {"type": "integer", "minimum": 0, "maximum": 65535},
          "scaled_value": {"type": ["number", "null"]},
          "prev_raw_value": {"type": ["integer", "null"]},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
