{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oni-a650/profile.schema.json",
  "title": "ONI A650 Configuration Profile",
  "type": "object",
  "required": ["meta", "communication"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["profile_name", "schema_version"],
      "properties": {
        "profile_name": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "const": "1.0.0-draft" },
        "created_at": { "type": "string", "format": "date-time" },
        "drive_model": { "type": "string", "const": "A650" },
        "firmware_version": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "communication": {
      "type": "object",
      "required": ["slave_address", "baud_rate", "data_format"],
      "additionalProperties": false,
      "properties": {
        "slave_address": { "type": "integer", "minimum": 1, "maximum": 127,
          "description": "Кадровый диапазон по А.4 (0..127). F15.02 допускает до 247 — см. discrepancy в PROTOCOL.md." },
        "baud_rate": { "type": "integer", "enum": [4800, 9600, 19200, 38400, 57600, 115200] },
        "data_format": { "type": "string", "enum": ["1-8-N-1", "1-8-N-2", "1-8-E-1", "1-8-O-1"],
          "description": "Задаётся явно; не полагаться на default (конфликт А.2 vs F15.01)." },
        "response_delay_ms": { "type": "integer", "minimum": 0, "maximum": 200 },
        "timeout_s": { "type": "number", "minimum": 0, "maximum": 60 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_enabled": { "type": "boolean", "default": false },
        "control_enabled": { "type": "boolean", "default": false },
        "require_diff_confirm": { "type": "boolean", "default": true }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Ключ — код параметра (напр. F15.02). Значение — желаемая установка.",
      "additionalProperties": {
        "type": "object",
        "required": ["code", "value"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[FHU][0-9]{2}\\.[0-9]{2}$" },
          "value": {},
          "unit": { "type": "string" },
          "verified_on_device": { "type": "boolean", "default": false,
            "description": "false = гипотеза/не проверено; запись таких полей блокируется в safe-режиме." }
        }
      }
    }
  }
}
